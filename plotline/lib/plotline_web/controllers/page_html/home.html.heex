<div class="flex min-h-screen flex-col lg:flex-row">
  <%!-- Left panel: welcome + gradient + loops decoration --%>
  <section
    id="landing-hero"
    class="relative flex min-h-[42vh] flex-1 flex-col justify-center overflow-hidden bg-gradient-to-b from-[#74AC8D] to-[#2F5C43] px-8 py-14 lg:min-h-screen lg:px-14 lg:py-0"
  >
    <div
      id="landing-loops-decoration"
      class="pointer-events-none absolute text-[#245037] opacity-40"
      style="width: 677px; height: 677px; left: -122px; top: -370px; transform: rotate(77.56deg);"
      aria-hidden="true"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="h-full w-full" fill="none">
        <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M12.353 7.837a5.93 5.93 0 0 1 7.682-1.542l17.812 10.287a5.93 5.93 0 0 1 0 10.271l-18.8 10.858a2.635 2.635 0 0 1-3.954-2.282V12.575" />
        <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M40.356 23.995a5.93 5.93 0 0 1-2.506 7.424L20.036 41.706a5.93 5.93 0 0 1-8.896-5.135V14.858a2.635 2.635 0 0 1 3.954-2.283l19.792 11.427" />
        <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M12.362 40.171a5.93 5.93 0 0 1-5.177-5.882l.002-20.573a5.93 5.93 0 0 1 8.896-5.136l18.803 10.857a2.636 2.636 0 0 1 0 4.564L15.094 35.429" />
      </svg>
    </div>

    <div
      id="landing-loops-decoration-bottom"
      class="pointer-events-none absolute text-[#245037] opacity-40"
      style="width: 677px; height: 677px; right: -60px; bottom: -340px; transform: rotate(77.56deg);"
      aria-hidden="true"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="h-full w-full" fill="none">
        <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M12.353 7.837a5.93 5.93 0 0 1 7.682-1.542l17.812 10.287a5.93 5.93 0 0 1 0 10.271l-18.8 10.858a2.635 2.635 0 0 1-3.954-2.282V12.575" />
        <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M40.356 23.995a5.93 5.93 0 0 1-2.506 7.424L20.036 41.706a5.93 5.93 0 0 1-8.896-5.135V14.858a2.635 2.635 0 0 1 3.954-2.283l19.792 11.427" />
        <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" d="M12.362 40.171a5.93 5.93 0 0 1-5.177-5.882l.002-20.573a5.93 5.93 0 0 1 8.896-5.136l18.803 10.857a2.636 2.636 0 0 1 0 4.564L15.094 35.429" />
      </svg>
    </div>

    <div class="relative z-10 max-w-lg">
      <h1 class="text-4xl font-bold tracking-tight text-[#F2E8CF] sm:text-5xl lg:text-6xl">
        Welcome Readers!
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-[#F2E8CF]/90 sm:text-xl">
        Stop forgetting where you left off. Get spoiler-free, chapter-by-chapter summaries with Plotline.
      </p>
    </div>
  </section>

  <%!-- Right panel: login --%>
  <section
    id="landing-auth"
    class="flex flex-1 flex-col justify-center bg-[#F2E8CF] px-8 py-12 lg:px-16 lg:py-0"
  >
    <div class="mx-auto w-full max-w-md">
      <p class="text-2xl font-bold text-[#212121]">Plotline</p>

      <h2 class="mt-10 text-3xl font-bold text-[#212121]">Welcome back!</h2>

      <p class="mt-3 text-sm text-[#212121]/80">
        New to Plotline?
        <a href={~p"/users/register"} class="font-medium text-[#212121] underline underline-offset-2">
          Create a new account here.
        </a>            
      </p>

      <%= if @flash["info"] do %>
        <p id="landing-flash-info" class="mt-4 rounded-lg bg-[#74AC8D]/20 px-4 py-3 text-sm text-[#212121]">
          {@flash["info"]}
        </p>
      <% end %>

      <%= if @flash["error"] do %>
        <p id="landing-flash-error" class="mt-4 rounded-lg bg-red-100 px-4 py-3 text-sm text-red-900">
          {@flash["error"]}
        </p>
      <% end %>

      <form
        id="landing-login-form"
        action={~p"/users/log-in"}
        method="post"
        class="mt-8 space-y-4"
      >
        <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
        <input type="hidden" name="return_to" value="/" />

        <div>
          <label for="landing-email" class="sr-only">Email</label>
          <input
            type="email"
            name="user[email]"
            id="landing-email"
            placeholder="Email"
            autocomplete="username"
            required
            class="w-full rounded-lg border-0 bg-white px-4 py-3.5 text-[#212121] shadow-md placeholder:text-[#212121]/40 focus:outline-none focus:ring-2 focus:ring-[#74AC8D]"
          />
        </div>

        <div>
          <label for="landing-password" class="sr-only">Password</label>
          <input
            type="password"
            name="user[password]"
            id="landing-password"
            placeholder="Password"
            autocomplete="current-password"
            class="w-full rounded-lg border-0 bg-white px-4 py-3.5 text-[#212121] shadow-md placeholder:text-[#212121]/40 focus:outline-none focus:ring-2 focus:ring-[#74AC8D]"
          />
        </div>

        <button
          type="submit"
          class="w-full rounded-lg bg-[#212121] px-4 py-3.5 text-base font-semibold text-[#F2E8CF] transition hover:bg-[#212121]/90"
        >
          Login
        </button>
      </form>

      <p class="mt-6 text-center text-sm text-[#212121]/70">
        Use the email and password you registered with.
      </p>
    </div>
  </section>
</div>
