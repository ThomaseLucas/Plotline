<div class="min-h-screen flex items-center justify-center bg-slate-50 dark:bg-slate-900">
  <div class="space-y-4 text-center">
    <%= if @current_scope && @current_scope.user do %>
      <h1 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">
        You’re signed in as <%= @current_scope.user.email %>
      </h1>
    <% end %>

    <div class="space-x-4">
      <.link navigate={~p"/users/log-in"} class="btn btn-primary">Log in</.link>
      <.link navigate={~p"/users/register"} class="btn btn-primary">Register</.link>
    </div>
  </div>
</div>
