<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Plotline" suffix=" · Phoenix Framework">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();
    </script>
  </head>
  <body class="font-sans" style="font-family: Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;">
      <header class="w-full bg-slate-900 text-slate-100">
        <div class="mx-auto flex h-12 max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
          <div class="flex items-center gap-3">
            <a href="/" class="flex items-center gap-3 text-sm font-semibold">
              <div class="h-6 w-6 rounded bg-rose-500" />
              <span class="hidden sm:block">Plotline</span>
            </a>
          </div>

          <div class="flex items-center gap-3 text-sm">
            <%= if @current_scope do %>
              <span class="text-slate-300"><%= @current_scope.user.email %></span>
              <.link href={~p"/users/settings"} class="text-slate-200">Settings</.link>
              <.link href={~p"/users/log-out"} method="delete" class="text-slate-200">Log out</.link>
            <% else %>
              <.link href={~p"/users/register"} class="text-slate-200">Register</.link>
              <.link href={~p"/users/log-in"} class="text-slate-200">Log in</.link>
            <% end %>
          </div>
        </div>
      </header>

    <main class="mt-6">{@inner_content}</main>
  </body>
</html>
